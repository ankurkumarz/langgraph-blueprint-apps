# Required – obtain from https://firecrawl.dev
FIRECRAWL_API_KEY=

# Required – obtain from https://console.cloud.google.com
GOOGLE_API_KEY=

# Optional – defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# CORS – comma-separated allowed origins (empty = no cross-origin requests)
# ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Max user query length in characters (default: 4000)
# MAX_QUERY_LENGTH=4000

# Max LangGraph agent iterations to prevent infinite loops (default: 15)
# MAX_AGENT_STEPS=15

# Max sequential follow-up rounds for complex "both" queries (default: 2)
# MAX_RESOLUTION_ROUNDS=2

# Orchestrator mode: "evaluator" (structured multi-node graph with separate
# evaluator LLM) or "think" (single ReAct loop with think_tool + delegation
# tools). Set to compare both approaches on the same queries.
# ORCHESTRATOR_MODE=evaluator

# Server config (dev entry point only)
# HOST=127.0.0.1
# PORT=8000
# ENV=development

# ── MLflow Tracing ────────────────────────────────────────────────────
# Set to true to enable MLflow tracing for all LangChain/LangGraph calls
# MLFLOW_ENABLED=true

# MLflow tracking server URL (default: http://localhost:5050)
# MLFLOW_TRACKING_URI=http://localhost:5050

# Experiment name in MLflow UI (default: langgraph-fastapi-streaming)
# MLFLOW_EXPERIMENT_NAME=langgraph-fastapi-streaming
